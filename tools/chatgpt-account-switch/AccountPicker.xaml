<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Account Switcher · 选择配置档" Width="660" Height="780" MinHeight="510" MinWidth="580"
        WindowStartupLocation="CenterScreen" Background="#FAFBFC" FontFamily="Microsoft YaHei UI" Foreground="#1F2933">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7"/><Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DCE2E7"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="AccountCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="17,14"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#879BAA"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#287CA0"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="28,24,28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Codex Account Switcher" FontFamily="Segoe UI Semibold" FontSize="16" Foreground="#536773"/>
      <TextBlock Text="这次使用哪个配置档？" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,8"/>
      <TextBlock Text="本地会话、项目和工作区共用；云端内容随账号而定。" TextWrapping="Wrap" FontSize="12" Foreground="#63717C"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,22,0,12">
      <TextBlock x:Name="LastProfile" Text="正在读取配置档…" Foreground="#63717C" FontSize="12" VerticalAlignment="Center"/>
      <Button x:Name="AddButton" Content="＋ 添加" HorizontalAlignment="Right" AutomationProperties.Name="添加配置档"/>
    </Grid>
    <ScrollViewer x:Name="ProfileScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ProfileCards" Margin="0,0,8,0"/></ScrollViewer>
    <Border Grid.Row="3" Background="#EEF2F5" CornerRadius="8" Padding="12,10" Margin="0,15,0,0"><StackPanel>
      <TextBlock x:Name="StatusText" Text="切换前，请退出 ChatGPT 和 Codex。" TextWrapping="Wrap" FontSize="12" Foreground="#536773"/>
      <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Margin="0,9,0,0" Visibility="Collapsed"/>
    </StackPanel></Border>
    <Expander x:Name="ErrorDetails" Grid.Row="4" Header="查看错误详情" Visibility="Collapsed" Margin="0,10,0,0" FontSize="12"><DockPanel>
      <Button x:Name="CopyErrorButton" Content="复制错误" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8"/>
      <TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" Padding="8" Margin="0,8,0,0"/>
    </DockPanel></Expander>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="RetryButton" Content="重试" Visibility="Collapsed" Margin="0,0,8,0"/>
      <Button x:Name="CancelLoginButton" Content="取消登录" Visibility="Collapsed" Margin="0,0,8,0"/>
      <Button x:Name="CancelButton" Content="关闭" IsCancel="True"/>
      <Button x:Name="RepairButton" Content="重置 / 修复" ToolTip="校验并修复切换配置，不清空共享会话。" Margin="10,0,0,0"/>
    </StackPanel>
  </Grid>
</Window>
